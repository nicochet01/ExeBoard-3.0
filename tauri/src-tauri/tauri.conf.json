{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ExeBoard",
  "version": "3.1.1",
  "identifier": "com.viasoft.exeboard",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ExeBoard",
        "width": 1100,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 700,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../config-padrao.json": "config-padrao.json"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "PortugueseBR"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE3REE1NzZGOTVFQTRDQTgKUldTb1RPcVZiMWZhcDdwdzZaMHJpL1l4QzhJd3Y0dUhNVDBzY1VQTHVlUS81TEpNR2YxYUh4R20K",
      "endpoints": [
        "https://github.com/nicochet01/ExeBoard-3.0/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
